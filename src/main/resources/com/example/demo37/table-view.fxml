<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo37.HelloController">
    <children>
        <TableView fx:id="tableView" layoutX="14.0" layoutY="14.0" prefHeight="250.0" prefWidth="400.0">
            <columns>
                <TableColumn fx:id="brandColumn" text="BRAND"/>
                <TableColumn fx:id="yearColumn" text="Year"/>
                <TableColumn fx:id="priceColumn" text="Price"/>
            </columns>
        </TableView>
    </children>
</AnchorPane>
